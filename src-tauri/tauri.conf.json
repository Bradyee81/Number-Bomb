{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Number Bomb",
  "version": "0.3.1",
  "identifier": "com.brad.numberbomb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "Number Bomb — Control",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      },
      {
        "label": "output",
        "title": "Number Bomb — Output",
        "url": "index.html",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENkJFRjRGNDk5OUFCRDYKUldUV3E1bEpUKzlyL1RSNUhKNVpDeTZGQXJad0NFRWx6VUhFS0VJZjZ0Z28vb21JNXlNenFVeTMK",
      "endpoints": [
        "https://github.com/Bradyee81/Number-Bomb/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
